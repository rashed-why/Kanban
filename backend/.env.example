# PostgreSQL (docker-compose `postgres` service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=Kanban
# Host port for Postgres — useful for local psql/pgAdmin; not required for the API container
POSTGRES_PORT=5433

# When running via Docker Compose, DATABASE_URL is overridden to use the `postgres` service.
# For local `yarn start:dev` without Docker, point this at your host database:
# DATABASE_URL="postgresql://postgres:change-me@localhost:5432/Kanban?schema=public"

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
PORT=4000
FRONTEND_URL=http://localhost:3000
